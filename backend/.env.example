APP_NAME=AIWorkbench
# Redis 强依赖：事件总线/对话流多订阅者/分布式锁/共享状态。缺项后端启动失败。
REDIS_URL=redis://127.0.0.1:6379/0
# 业务数据库：PG（生产口径）或 SQLite（开发/无中间件）
DATABASE_URL=postgresql+asyncpg://aiwb:aiwb@127.0.0.1:54329/ai_workbench
# SQLite 口径：sqlite+aiosqlite:///./data/ai_workbench.db
# 向量存储与业务库分离，可独立切换：
#   auto    = 按 DATABASE_URL 推导（PG → pgvector，非 PG → none）
#   pgvector= 用业务 PG 库存向量（要求 DATABASE_URL 是 postgresql）
#   none    = 显式停用（知识库切块/语义检索与 MCP 工具语义索引显式失败）
VECTOR_BACKEND=auto
# bootstrap 首个管理员：邮箱 + 密码（密码即 AUTH_TOKEN）
AUTH_ADMIN_EMAIL=admin@local
AUTH_TOKEN=change-me
# 凭证库字段加密密钥：与 AUTH_TOKEN 解耦，轮换登录口令不要动这里
# （改了会让已存凭证永久不可解）。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
CREDENTIAL_ENCRYPTION_KEY=change-me-credential-encryption-key
SEED_LLM_PROVIDER=deepseek
SEED_LLM_BASE_URL=https://api.deepseek.com
SEED_LLM_API_KEY=
SEED_LLM_MODEL=deepseek-flash
# 联网搜索（DeepSeek 官方 Search API）独立凭证，与设置页 LLM provider 解耦：
# 留空则联网搜索不可用（不阻断其它功能）；base_url 缺省为 https://api.deepseek.com
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.deepseek.com
# litellm 模型名前缀：OpenAI 兼容端点填 openai/；空串表示不加前缀
SEED_LLM_MODEL_PREFIX=openai/
# 厂商专属请求体（JSON 对象文本）；只有需要厂商专属开关的厂商才配
SEED_LLM_EXTRA_BODY_JSON=
# LiteLLM 用本地价格表，不拉 GitHub（拉取超时会让进程首个回合白等 10+ 秒）
LITELLM_LOCAL_MODEL_COST_MAP=True
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=4096
# 嵌入服务鉴权密钥；内网无鉴权服务留空
EMBEDDING_API_KEY=
HOST=127.0.0.1
PORT=18080
LOG_LEVEL=INFO
# 沙盒（Docker 隔离执行不可信代码）
# 执行器：docker = 容器隔离（默认）；local = 本地不安全直跑，仅限可信开发环境
SANDBOX_EXECUTOR=docker
# Docker 守护进程地址；留空用本机默认。Docker 跑在 WSL 时填 tcp://<WSL_IP>:2375
SANDBOX_DOCKER_HOST=
# 沙盒镜像：默认用预装常见依赖的本地镜像（断网沙箱也需要 requests/numpy 等）。
# 首次使用先构建：sh scripts/build-sandbox-image.sh（见 backend/sandbox/）。
# 不用预装包可改回 python:3.12-slim（断网下只能用标准库）。
SANDBOX_IMAGE=ai-workbench-sandbox:local
# 沙盒是否允许联网：默认断网，防数据外泄
SANDBOX_NETWORK_ENABLED=false
# 沙盒单次执行超时（秒）
SANDBOX_TIMEOUT_SECONDS=120
