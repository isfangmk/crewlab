APP_NAME=AIWorkbench
DATABASE_URL=postgresql+asyncpg://aiwb:aiwb@127.0.0.1:54329/ai_workbench
# bootstrap 首个管理员：邮箱 + 密码（密码即 AUTH_TOKEN）
AUTH_ADMIN_EMAIL=admin@local
AUTH_TOKEN=change-me
# 凭证库字段加密密钥：与 AUTH_TOKEN 解耦，轮换登录口令不要动这里
# （改了会让已存凭证永久不可解）。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
CREDENTIAL_ENCRYPTION_KEY=change-me-credential-encryption-key
SEED_LLM_PROVIDER=deepseek
SEED_LLM_BASE_URL=https://api.deepseek.com
SEED_LLM_API_KEY=
SEED_LLM_MODEL=deepseek-flash
# litellm 模型名前缀：OpenAI 兼容端点填 openai/；空串表示不加前缀
SEED_LLM_MODEL_PREFIX=openai/
# 厂商专属请求体（JSON 对象文本）；只有需要 thinking 等开关的厂商才配
SEED_LLM_EXTRA_BODY_JSON={"thinking":{"type":"enabled"}}
EMBEDDING_BASE_URL=http://10.241.100.240:16013
EMBEDDING_MODEL=br-embedding
EMBEDDING_DIM=2560
HOST=127.0.0.1
PORT=18080
LOG_LEVEL=INFO
