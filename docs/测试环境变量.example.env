# 复制为 backend/.env 后填写；禁止提交真实密钥

# 对话模型（配置-模型的初始种子，也可只在 UI 里配）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 嵌入
EMBEDDING_BASE_URL=http://10.241.100.240:16013
EMBEDDING_MODEL=br-embedding
EMBEDDING_DIM=2560

# PostgreSQL（需启用 pgvector）
DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/ai_workbench

# 登录口令
AUTH_TOKEN=
# 凭证库字段加密密钥：与 AUTH_TOKEN 解耦，轮换登录口令不要动这里
# （改了会让已存凭证永久不可解）。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
CREDENTIAL_ENCRYPTION_KEY=
