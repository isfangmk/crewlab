# 环境与密钥
.env
.env.local
**/.env
**/secrets/

# 后端运行时
backend/.venv/

# 运行日志与 PID（目录保留，文件不入库）
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
pytest-of-*/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
web/node_modules/
web/dist/
web/.tmp-esbuild/
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# 后端运行时数据（业务库 / 向量库 / 上传原件）
backend/data/

# ZCode 会话工作区（计划/运行时状态），不进版本库
.zcode/

# codebase-memory-mcp 索引快照（运行产物，可重建；团队共享时按需单独分发）
.codebase-memory/
